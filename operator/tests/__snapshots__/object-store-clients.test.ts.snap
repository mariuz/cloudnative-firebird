// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the aws client (the default) > is what it was before the object store builder: SSE-C 1`] = `
{
  "bootstrap from a logical backup": [
    {
      "args": [
        "set -eu; if [ -f "$DATABASE_PATH" ] || [ -f "$TARGET_PATH" ]; then echo "database exists, skipping bootstrap"; exit 0; fi; if [ -n "\${PRIMARY_FILE:-}" ]; then p=$(cat "$PRIMARY_FILE" 2>/dev/null || true); case "$p" in ""|"$POD_NAME"|"$POD_NAME".*) ;; *) echo "replica: seeded by replication, skipping bootstrap"; exit 0 ;; esac; fi; aws s3 cp --sse-c AES256 --sse-c-key fileb:///var/run/s3-sse-c/s3/key 's3://bkt/p/nightly/x.fbk' /work/backup.fbk",
      ],
      "command": [
        "/bin/sh",
        "-c",
      ],
      "env": [
        {
          "name": "POD_NAME",
          "valueFrom": {
            "fieldRef": {
              "fieldPath": "metadata.name",
            },
          },
        },
        {
          "name": "DATABASE_PATH",
          "value": "/var/lib/firebird/data/mydb.fdb",
        },
        {
          "name": "TARGET_PATH",
          "value": "/var/lib/firebird/data/mydb.fdb",
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "valueFrom": {
            "secretKeyRef": {
              "key": "AWS_ACCESS_KEY_ID",
              "name": "s3-creds",
            },
          },
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "valueFrom": {
            "secretKeyRef": {
              "key": "AWS_SECRET_ACCESS_KEY",
              "name": "s3-creds",
            },
          },
        },
        {
          "name": "AWS_DEFAULT_REGION",
          "value": "us-east-1",
        },
      ],
      "image": "amazon/aws-cli:2.37.4",
      "name": "bootstrap-download",
      "volumeMounts": [
        {
          "mountPath": "/var/lib/firebird/data",
          "name": "firebird-data",
        },
        {
          "mountPath": "/work",
          "name": "work",
        },
        {
          "mountPath": "/var/run/s3-sse-c/s3",
          "name": "s3-sse-c",
          "readOnly": true,
        },
      ],
    },
    {
      "args": [
        "set -eu; if [ -f "$DATABASE_PATH" ] || [ -f "$TARGET_PATH" ]; then echo "database exists, skipping bootstrap"; exit 0; fi; if [ -n "\${PRIMARY_FILE:-}" ]; then p=$(cat "$PRIMARY_FILE" 2>/dev/null || true); case "$p" in ""|"$POD_NAME"|"$POD_NAME".*) ;; *) echo "replica: seeded by replication, skipping bootstrap"; exit 0 ;; esac; fi; rm -f "$TARGET_PATH.tmp"; gbak -c '/work/backup.fbk' "$TARGET_PATH.tmp"; [ "$(id -u)" -ne 0 ] || chown firebird:firebird "$TARGET_PATH.tmp"; mv "$TARGET_PATH.tmp" "$TARGET_PATH"; echo "restored database from /work/backup.fbk"",
      ],
      "command": [
        "/bin/sh",
        "-c",
      ],
      "env": [
        {
          "name": "POD_NAME",
          "valueFrom": {
            "fieldRef": {
              "fieldPath": "metadata.name",
            },
          },
        },
        {
          "name": "DATABASE_PATH",
          "value": "/var/lib/firebird/data/mydb.fdb",
        },
        {
          "name": "TARGET_PATH",
          "value": "/var/lib/firebird/data/mydb.fdb",
        },
        {
          "name": "ISC_USER",
          "value": "SYSDBA",
        },
        {
          "name": "ISC_PASSWORD",
          "value": "masterkey",
        },
      ],
      "image": "firebirdsql/firebird:latest",
      "name": "bootstrap-restore",
      "volumeMounts": [
        {
          "mountPath": "/var/lib/firebird/data",
          "name": "firebird-data",
        },
        {
          "mountPath": "/work",
          "name": "work",
        },
      ],
    },
  ],
  "cluster backup schedule": {
    "containers": [
      {
        "args": [
          "set -eu; f=$(cat /work/.name); aws s3 cp --sse-c AES256 --sse-c-key fileb:///var/run/s3-sse-c/s3/key "/work/$f" "s3://bkt/p/$f"",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "AWS_ACCESS_KEY_ID",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_ACCESS_KEY_ID",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_SECRET_ACCESS_KEY",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_SECRET_ACCESS_KEY",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_DEFAULT_REGION",
            "value": "us-east-1",
          },
        ],
        "image": "amazon/aws-cli:2.37.4",
        "name": "upload",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
          {
            "mountPath": "/var/run/s3-sse-c/s3",
            "name": "s3-sse-c",
            "readOnly": true,
          },
        ],
      },
    ],
    "initContainers": [
      {
        "args": [
          "set -eu; f="backup-db-$(date -u +%Y%m%dT%H%M%SZ).fbk"; gbak -b "$FIREBIRD_HOST:$DATABASE_PATH" "/work/$f"; echo "$f" > /work/.name",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "ISC_USER",
            "value": "SYSDBA",
          },
          {
            "name": "ISC_PASSWORD",
            "value": "masterkey",
          },
          {
            "name": "FIREBIRD_HOST",
            "value": "db-0.db-headless",
          },
          {
            "name": "DATABASE_PATH",
            "value": "/var/lib/firebird/data/mydb.fdb",
          },
        ],
        "image": "firebirdsql/firebird:latest",
        "name": "firebird-backup",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
        ],
      },
    ],
    "restartPolicy": "Never",
    "securityContext": {
      "runAsGroup": 84,
      "runAsNonRoot": true,
      "runAsUser": 84,
      "seccompProfile": {
        "type": "RuntimeDefault",
      },
    },
    "volumes": [
      {
        "emptyDir": {},
        "name": "work",
      },
      {
        "name": "s3-sse-c",
        "secret": {
          "defaultMode": 292,
          "items": [
            {
              "key": "SSE_C_KEY",
              "path": "key",
            },
          ],
          "secretName": "ssec",
        },
      },
    ],
  },
  "journal archive": {
    "containers": [
      {
        "args": [
          "set -eu; aws s3 sync --sse-c AES256 --sse-c-key fileb:///var/run/s3-sse-c/s3/key /work/segments/ 's3://bkt/p/journals/'; for f in $DATABASES; do d=/work/db/$f; mkdir -p $d; [ ! -d $d/segments ] || aws s3 sync --sse-c AES256 --sse-c-key fileb:///var/run/s3-sse-c/s3/key $d/segments/ 's3://bkt/p/journals/'"$f/"; done",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "AWS_ACCESS_KEY_ID",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_ACCESS_KEY_ID",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_SECRET_ACCESS_KEY",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_SECRET_ACCESS_KEY",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_DEFAULT_REGION",
            "value": "us-east-1",
          },
          {
            "name": "DATABASES",
            "value": "sales.fdb",
          },
          {
            "name": "FB_AGENT",
            "value": "/opt/fb-agent/fb-agent",
          },
        ],
        "image": "amazon/aws-cli:2.37.4",
        "name": "upload",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
          {
            "mountPath": "/var/run/s3-sse-c/s3",
            "name": "s3-sse-c",
            "readOnly": true,
          },
          {
            "mountPath": "/opt/fb-agent",
            "name": "fb-agent",
            "readOnly": true,
          },
        ],
      },
    ],
    "initContainers": [
      {
        "command": [
          "cp",
          "/app/fb-agent",
          "/agent/fb-agent",
        ],
        "image": "ghcr.io/mariuz/cloudnative-firebird:latest",
        "name": "agent-install",
        "resources": {
          "requests": {
            "cpu": "10m",
            "memory": "16Mi",
          },
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
          "readOnlyRootFilesystem": true,
          "runAsGroup": 65532,
          "runAsNonRoot": true,
          "runAsUser": 65532,
        },
        "volumeMounts": [
          {
            "mountPath": "/agent",
            "name": "fb-agent",
          },
        ],
      },
      {
        "args": [
          "aws s3 ls 's3://bkt/p/journals/' > /work/listing || true; awk '{ print $4 }' /work/listing > /work/uploaded; for f in $DATABASES; do d=/work/db/$f; mkdir -p $d; { aws s3 ls 's3://bkt/p/journals/'"$f/" > $d/listing || true; }; awk '{ print $4 }' $d/listing > $d/uploaded; done",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "AWS_ACCESS_KEY_ID",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_ACCESS_KEY_ID",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_SECRET_ACCESS_KEY",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_SECRET_ACCESS_KEY",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_DEFAULT_REGION",
            "value": "us-east-1",
          },
          {
            "name": "DATABASES",
            "value": "sales.fdb",
          },
          {
            "name": "FB_AGENT",
            "value": "/opt/fb-agent/fb-agent",
          },
        ],
        "image": "amazon/aws-cli:2.37.4",
        "name": "list-uploaded",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
          {
            "mountPath": "/opt/fb-agent",
            "name": "fb-agent",
            "readOnly": true,
          },
        ],
      },
      {
        "command": [
          "/opt/fb-agent/fb-agent",
          "fetch-segments",
        ],
        "env": [
          {
            "name": "ISC_USER",
            "value": "SYSDBA",
          },
          {
            "name": "ISC_PASSWORD",
            "value": "masterkey",
          },
          {
            "name": "FIREBIRD_HOST",
            "value": "db-0.db-headless",
          },
          {
            "name": "SEGMENT_PORT",
            "value": "3051",
          },
          {
            "name": "OUT_DIR",
            "value": "/work/segments",
          },
          {
            "name": "SKIP_FILE",
            "value": "/work/uploaded",
          },
          {
            "name": "LISTED_FILE",
            "value": "/work/listed-max",
          },
          {
            "name": "RESULT_FILE",
            "value": "/dev/termination-log",
          },
          {
            "name": "FB_AGENT",
            "value": "/opt/fb-agent/fb-agent",
          },
        ],
        "image": "firebirdsql/firebird:latest",
        "name": "fetch-segments",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
          {
            "mountPath": "/etc/firebird-operator",
            "name": "cluster-config",
            "readOnly": true,
          },
          {
            "mountPath": "/opt/fb-agent",
            "name": "fb-agent",
            "readOnly": true,
          },
        ],
      },
      {
        "args": [
          "set -eu; for f in $DATABASES; do d=/work/db/$f; mkdir -p $d; SEGMENT_DATABASE=$f OUT_DIR=$d/segments SKIP_FILE=$d/uploaded LISTED_FILE=$d/listed-max RESULT_FILE=$d/result /opt/fb-agent/fb-agent fetch-segments; done",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "ISC_USER",
            "value": "SYSDBA",
          },
          {
            "name": "ISC_PASSWORD",
            "value": "masterkey",
          },
          {
            "name": "FIREBIRD_HOST",
            "value": "db-0.db-headless",
          },
          {
            "name": "SEGMENT_PORT",
            "value": "3051",
          },
          {
            "name": "DATABASES",
            "value": "sales.fdb",
          },
          {
            "name": "FB_AGENT",
            "value": "/opt/fb-agent/fb-agent",
          },
        ],
        "image": "firebirdsql/firebird:latest",
        "name": "fetch-database-segments",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
          {
            "mountPath": "/etc/firebird-operator",
            "name": "cluster-config",
            "readOnly": true,
          },
          {
            "mountPath": "/opt/fb-agent",
            "name": "fb-agent",
            "readOnly": true,
          },
        ],
      },
    ],
    "restartPolicy": "Never",
    "securityContext": {
      "runAsGroup": 84,
      "runAsNonRoot": true,
      "runAsUser": 84,
      "seccompProfile": {
        "type": "RuntimeDefault",
      },
    },
    "volumes": [
      {
        "emptyDir": {},
        "name": "work",
      },
      {
        "configMap": {
          "name": "db-config",
        },
        "name": "cluster-config",
      },
      {
        "name": "s3-sse-c",
        "secret": {
          "defaultMode": 292,
          "items": [
            {
              "key": "SSE_C_KEY",
              "path": "key",
            },
          ],
          "secretName": "ssec",
        },
      },
      {
        "emptyDir": {},
        "name": "fb-agent",
      },
    ],
  },
  "logical backup": {
    "containers": [
      {
        "args": [
          "set -eu; f=$(cat /work/.name); aws s3 cp --sse-c AES256 --sse-c-key fileb:///var/run/s3-sse-c/s3/key "/work/$f" "s3://bkt/p/$f"",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "AWS_ACCESS_KEY_ID",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_ACCESS_KEY_ID",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_SECRET_ACCESS_KEY",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_SECRET_ACCESS_KEY",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_DEFAULT_REGION",
            "value": "us-east-1",
          },
        ],
        "image": "amazon/aws-cli:2.37.4",
        "name": "upload",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
          {
            "mountPath": "/var/run/s3-sse-c/s3",
            "name": "s3-sse-c",
            "readOnly": true,
          },
        ],
      },
    ],
    "initContainers": [
      {
        "args": [
          "set -eu; f="backup-b1.fbk"; gbak -b "$FIREBIRD_HOST:$DATABASE_PATH" "/work/$f"; echo "$f" > /work/.name",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "ISC_USER",
            "value": "SYSDBA",
          },
          {
            "name": "ISC_PASSWORD",
            "value": "masterkey",
          },
          {
            "name": "FIREBIRD_HOST",
            "value": "db-0.db-headless",
          },
          {
            "name": "DATABASE_PATH",
            "value": "/var/lib/firebird/data/mydb.fdb",
          },
        ],
        "image": "firebirdsql/firebird:latest",
        "name": "firebird-backup",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
        ],
      },
    ],
    "restartPolicy": "Never",
    "securityContext": {
      "runAsGroup": 84,
      "runAsNonRoot": true,
      "runAsUser": 84,
      "seccompProfile": {
        "type": "RuntimeDefault",
      },
    },
    "volumes": [
      {
        "emptyDir": {},
        "name": "work",
      },
      {
        "name": "s3-sse-c",
        "secret": {
          "defaultMode": 292,
          "items": [
            {
              "key": "SSE_C_KEY",
              "path": "key",
            },
          ],
          "secretName": "ssec",
        },
      },
    ],
  },
  "logical restore": {
    "containers": [
      {
        "args": [
          "set -eu; gbak -c /work/backup.fbk "$FIREBIRD_HOST:$TARGET_PATH"; echo "restored into $TARGET_PATH"",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "ISC_USER",
            "value": "SYSDBA",
          },
          {
            "name": "ISC_PASSWORD",
            "value": "masterkey",
          },
          {
            "name": "FIREBIRD_HOST",
            "value": "db-0.db-headless",
          },
          {
            "name": "TARGET_PATH",
            "value": "/var/lib/firebird/data/restore-r1.fdb",
          },
        ],
        "image": "firebirdsql/firebird:latest",
        "name": "firebird-restore",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
        ],
      },
    ],
    "initContainers": [
      {
        "args": [
          "set -eu; aws s3 cp --sse-c AES256 --sse-c-key fileb:///var/run/s3-sse-c/s3/key 's3://bkt/p/backup-b1.fbk' /work/backup.fbk",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "AWS_ACCESS_KEY_ID",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_ACCESS_KEY_ID",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_SECRET_ACCESS_KEY",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_SECRET_ACCESS_KEY",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_DEFAULT_REGION",
            "value": "us-east-1",
          },
        ],
        "image": "amazon/aws-cli:2.37.4",
        "name": "download",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
          {
            "mountPath": "/var/run/s3-sse-c/s3",
            "name": "s3-sse-c",
            "readOnly": true,
          },
        ],
      },
    ],
    "restartPolicy": "Never",
    "securityContext": {
      "runAsGroup": 84,
      "runAsNonRoot": true,
      "runAsUser": 84,
      "seccompProfile": {
        "type": "RuntimeDefault",
      },
    },
    "volumes": [
      {
        "emptyDir": {},
        "name": "work",
      },
      {
        "name": "s3-sse-c",
        "secret": {
          "defaultMode": 292,
          "items": [
            {
              "key": "SSE_C_KEY",
              "path": "key",
            },
          ],
          "secretName": "ssec",
        },
      },
    ],
  },
  "nbackup of a replica": {
    "containers": [
      {
        "args": [
          "set -eu; f=$(cat /work/.name); if [ -f "/work/$f.ctl" ]; then aws s3 cp --sse-c AES256 --sse-c-key fileb:///var/run/s3-sse-c/s3/key "/work/$f.ctl" "s3://bkt/p/$f.ctl"; fi; aws s3 cp --sse-c AES256 --sse-c-key fileb:///var/run/s3-sse-c/s3/key "/work/$f" "s3://bkt/p/$f"",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "AWS_ACCESS_KEY_ID",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_ACCESS_KEY_ID",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_SECRET_ACCESS_KEY",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_SECRET_ACCESS_KEY",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_DEFAULT_REGION",
            "value": "us-east-1",
          },
          {
            "name": "FB_AGENT",
