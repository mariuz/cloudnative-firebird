        },
        "name": "cluster-config",
      },
      {
        "emptyDir": {},
        "name": "fb-agent",
      },
    ],
  },
  "logical backup": {
    "containers": [
      {
        "args": [
          "set -eu; f=$(cat /work/.name); aws s3 cp --sse aws:kms --sse-kms-key-id 'alias/fb' "/work/$f" "s3://bkt/p/$f"",
        ],
        "command": [
          "/bin/sh",
