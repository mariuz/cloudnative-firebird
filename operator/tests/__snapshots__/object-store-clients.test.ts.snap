  "scheduled logical backup with retention": {
    "containers": [
      {
        "args": [
          "set -eu; f=$(cat /work/.name); aws s3 cp "/work/$f" "s3://bkt/$f"; cutoff=$(date -u -d "@$(( $(date +%s) - 604800 ))" +%Y%m%dT%H%M%SZ); { aws s3 ls 's3://bkt/' | awk '{ print $4 }'; } > /work/all || true; grep -E '^backup-nightly-[0-9]{8}T[0-9]{6}Z[.]fbk$' /work/all | sort > /work/series || true; newest=$(tail -n 1 /work/series); awk -v c="$cutoff" -v n="$newest" -v f="$f" '$0 != n && $0 != f { ts = $0; sub(/^.*-/, "", ts); sub(/[.]fbk$/, "", ts); if (ts < c) print }' /work/series > /work/expired; while read -r k; do aws s3 rm 's3://bkt/'"$k"; echo "retention: deleted $k"; done < /work/expired; echo "retention: kept $(( $(wc -l < /work/series) - $(wc -l < /work/expired) )) backup(s) of nightly newer than $cutoff, newest"",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "AWS_DEFAULT_REGION",
            "value": "us-east-1",
          },
        ],
        "image": "example.com/aws-cli:2",
        "name": "upload",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
