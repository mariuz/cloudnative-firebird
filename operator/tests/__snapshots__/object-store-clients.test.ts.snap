      },
    ],
  },
  "scheduled logical backup with retention": {
    "containers": [
      {
        "args": [
          "set -eu; f=$(cat /work/.name); aws s3 cp --sse aws:kms --sse-kms-key-id 'alias/fb' "/work/$f" "s3://bkt/p/$f"; cutoff=$(date -u -d "@$(( $(date +%s) - 604800 ))" +%Y%m%dT%H%M%SZ); { aws s3 ls 's3://bkt/p/' | awk '{ print $4 }'; } > /work/all || true; grep -E '^backup-nightly-[0-9]{8}T[0-9]{6}Z[.]fbk$' /work/all | sort > /work/series || true; newest=$(tail -n 1 /work/series); awk -v c="$cutoff" -v n="$newest" -v f="$f" '$0 != n && $0 != f { ts = $0; sub(/^.*-/, "", ts); sub(/[.]fbk$/, "", ts); if (ts < c) print }' /work/series > /work/expired; while read -r k; do aws s3 rm 's3://bkt/p/'"$k"; echo "retention: deleted $k"; done < /work/expired; echo "retention: kept $(( $(wc -l < /work/series) - $(wc -l < /work/expired) )) backup(s) of nightly newer than $cutoff, newest"",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "AWS_ACCESS_KEY_ID",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_ACCESS_KEY_ID",
