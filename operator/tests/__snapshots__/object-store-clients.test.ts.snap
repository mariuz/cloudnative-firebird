            "name": "fb-agent",
          },
        ],
      },
      {
        "args": [
          "set -eu; f="nbackup-l1-b1.nbk"; trap '/opt/fb-agent/fb-agent backup-file remove "$f" "$f.ctl" || true' EXIT; out=$(/opt/fb-agent/fb-agent backup-file nbackup 1 "$f"); echo "$out"; /opt/fb-agent/fb-agent backup-file get "$f" "/work/$f"; case "$out" in *"replica position"*) /opt/fb-agent/fb-agent backup-file get "$f.ctl" "/work/$f.ctl" ;; esac; echo "$f" > /work/.name",
