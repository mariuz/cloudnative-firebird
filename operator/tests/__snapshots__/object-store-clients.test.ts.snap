  "scheduled logical backup with retention": {
    "containers": [
      {
        "args": [
          "set -eu; f=$(cat /work/.name); aws s3 cp --sse-c AES256 --sse-c-key fileb:///var/run/s3-sse-c/s3/key "/work/$f" "s3://bkt/p/$f"; cutoff=$(date -u -d "@$(( $(date +%s) - 604800 ))" +%Y%m%dT%H%M%SZ); { aws s3 ls 's3://bkt/p/' | awk '{ print $4 }'; } > /work/all || true; grep -E '^backup-nightly-[0-9]{8}T[0-9]{6}Z[.]fbk$' /work/all | sort > /work/series || true; newest=$(tail -n 1 /work/series); awk -v c="$cutoff" -v n="$newest" -v f="$f" '$0 != n && $0 != f { ts = $0; sub(/^.*-/, "", ts); sub(/[.]fbk$/, "", ts); if (ts < c) print }' /work/series > /work/expired; while read -r k; do aws s3 rm 's3://bkt/p/'"$k"; echo "retention: deleted $k"; done < /work/expired; echo "retention: kept $(( $(wc -l < /work/series) - $(wc -l < /work/expired) )) backup(s) of nightly newer than $cutoff, newest"",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "AWS_ACCESS_KEY_ID",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_ACCESS_KEY_ID",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_SECRET_ACCESS_KEY",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_SECRET_ACCESS_KEY",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_DEFAULT_REGION",
            "value": "us-east-1",
          },
        ],
        "image": "amazon/aws-cli:2.37.4",
        "name": "upload",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
          {
            "mountPath": "/var/run/s3-sse-c/s3",
            "name": "s3-sse-c",
            "readOnly": true,
          },
        ],
      },
    ],
    "initContainers": [
      {
        "args": [
          "set -eu; f="backup-nightly-$(date -u +%Y%m%dT%H%M%SZ).fbk"; gbak -b "$FIREBIRD_HOST:$DATABASE_PATH" "/work/$f"; echo "$f" > /work/.name",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "ISC_USER",
            "value": "SYSDBA",
          },
          {
            "name": "ISC_PASSWORD",
            "value": "masterkey",
          },
          {
            "name": "FIREBIRD_HOST",
            "value": "db-0.db-headless",
          },
          {
            "name": "DATABASE_PATH",
            "value": "/var/lib/firebird/data/mydb.fdb",
          },
        ],
        "image": "firebirdsql/firebird:latest",
        "name": "firebird-backup",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
        ],
      },
    ],
    "restartPolicy": "Never",
    "securityContext": {
      "runAsGroup": 84,
      "runAsNonRoot": true,
      "runAsUser": 84,
      "seccompProfile": {
        "type": "RuntimeDefault",
      },
    },
    "volumes": [
      {
        "emptyDir": {},
        "name": "work",
      },
      {
        "name": "s3-sse-c",
        "secret": {
          "defaultMode": 292,
          "items": [
            {
              "key": "SSE_C_KEY",
              "path": "key",
            },
          ],
          "secretName": "ssec",
        },
      },
    ],
  },
  "scheduled nbackup with retention": {
    "containers": [
      {
        "args": [
          "set -eu; f=$(cat /work/.name); if [ -f "/work/$f.ctl" ]; then aws s3 cp --sse-c AES256 --sse-c-key fileb:///var/run/s3-sse-c/s3/key "/work/$f.ctl" "s3://bkt/p/$f.ctl"; fi; aws s3 cp --sse-c AES256 --sse-c-key fileb:///var/run/s3-sse-c/s3/key "/work/$f" "s3://bkt/p/$f"; cutoff=$(date -u -d "@$(( $(date +%s) - 2419200 ))" +%Y%m%dT%H%M%SZ); { aws s3 ls 's3://bkt/p/' | awk '{ print $4 }'; } > /work/all || true; grep -E '^nbackup-l[0-2]-nightly-[0-9]{8}T[0-9]{6}Z[.]nbk$' /work/all | sort > /work/series || true; newest=$(tail -n 1 /work/series); awk -v c="$cutoff" -v n="$newest" -v f="$f" 'function series(x) { if (sub(/^nbackup-l[0-2]-/, "", x) && sub(/-[0-9]+T[0-9]+Z[.]nbk$/, "", x)) return x; return "" } FILENAME == ARGV[1] { h++; lvl[h] = $1; name[h] = $2; next } FILENAME == ARGV[2] { here[$0] = 1; s = series($0); if (s != "") live[s] = 1; next } $0 != n && $0 != f { ts = $0; sub(/^.*-/, "", ts); sub(/[.]nbk$/, "", ts); if (ts < c) old[$0] = 1 } END { for (i = 1; i <= h; i++) { l = lvl[i]; par[i] = (l > 0 && (l - 1) in last) ? last[l - 1] : 0; last[l] = i; known[name[i]] = 1 } for (i = 1; i <= h; i++) { if (name[i] in old) continue; s = series(name[i]); if (!(name[i] in here) && s != "" && (s in live)) continue; for (p = par[i]; p; p = par[p]) needed[name[p]] = 1 } for (k in old) if ((k in known) && !(k in needed)) print k }' /work/history /work/all /work/series > /work/expired; while read -r k; do aws s3 rm 's3://bkt/p/'"$k"; aws s3 rm 's3://bkt/p/'"$k.ctl" >/dev/null 2>&1 || true; echo "retention: deleted $k"; done < /work/expired; echo "retention: kept $(( $(wc -l < /work/series) - $(wc -l < /work/expired) )) backup(s) of nightly newer than $cutoff, newest or needed by a kept chain"",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "AWS_ACCESS_KEY_ID",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_ACCESS_KEY_ID",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_SECRET_ACCESS_KEY",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_SECRET_ACCESS_KEY",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_DEFAULT_REGION",
            "value": "us-east-1",
          },
          {
            "name": "FB_AGENT",
            "value": "/opt/fb-agent/fb-agent",
          },
        ],
        "image": "amazon/aws-cli:2.37.4",
        "name": "upload",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
          {
            "mountPath": "/var/run/s3-sse-c/s3",
            "name": "s3-sse-c",
            "readOnly": true,
          },
          {
            "mountPath": "/opt/fb-agent",
            "name": "fb-agent",
            "readOnly": true,
          },
        ],
      },
    ],
    "initContainers": [
      {
        "command": [
          "cp",
          "/app/fb-agent",
          "/agent/fb-agent",
        ],
        "image": "ghcr.io/mariuz/cloudnative-firebird:latest",
        "name": "agent-install",
        "resources": {
          "requests": {
            "cpu": "10m",
            "memory": "16Mi",
          },
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
          "readOnlyRootFilesystem": true,
          "runAsGroup": 65532,
          "runAsNonRoot": true,
          "runAsUser": 65532,
        },
        "volumeMounts": [
          {
            "mountPath": "/agent",
            "name": "fb-agent",
          },
        ],
      },
      {
        "args": [
          "set -eu; f="nbackup-l0-nightly-$(date -u +%Y%m%dT%H%M%SZ).nbk"; trap '/opt/fb-agent/fb-agent backup-file remove "$f" || true' EXIT; fbsvcmgr "$FIREBIRD_HOST:service_mgr" action_nbak dbname "$DATABASE_PATH" nbk_file "/var/lib/firebird/data/$f" nbk_level 0; /opt/fb-agent/fb-agent backup-file get "$f" "/work/$f"; echo "$f" > /work/.name; echo 'set list on; select rdb$backup_level, rdb$file_name from rdb$backup_history order by rdb$backup_id;' | isql -q "$FIREBIRD_HOST:$DATABASE_PATH" | awk '/^RDB[$]BACKUP_LEVEL/ { l = $2 } /^RDB[$]FILE_NAME/ { n = $2; sub(/^.*[/]/, "", n); print l, n }' > /work/history",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "ISC_USER",
            "value": "SYSDBA",
          },
          {
            "name": "ISC_PASSWORD",
            "value": "masterkey",
          },
          {
            "name": "FIREBIRD_HOST",
            "value": "db-0.db-headless",
          },
          {
            "name": "DATABASE_PATH",
            "value": "/var/lib/firebird/data/mydb.fdb",
          },
          {
            "name": "SEGMENT_PORT",
            "value": "3051",
          },
          {
            "name": "FB_AGENT",
            "value": "/opt/fb-agent/fb-agent",
          },
        ],
        "image": "firebirdsql/firebird:latest",
        "name": "firebird-backup",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
          {
            "mountPath": "/etc/firebird-operator",
            "name": "cluster-config",
            "readOnly": true,
          },
          {
            "mountPath": "/opt/fb-agent",
            "name": "fb-agent",
            "readOnly": true,
          },
        ],
      },
    ],
    "restartPolicy": "Never",
    "securityContext": {
      "runAsGroup": 84,
      "runAsNonRoot": true,
      "runAsUser": 84,
      "seccompProfile": {
        "type": "RuntimeDefault",
      },
    },
    "volumes": [
      {
        "emptyDir": {},
        "name": "work",
      },
      {
        "configMap": {
          "name": "db-config",
        },
        "name": "cluster-config",
      },
      {
        "name": "s3-sse-c",
        "secret": {
          "defaultMode": 292,
          "items": [
            {
              "key": "SSE_C_KEY",
              "path": "key",
            },
          ],
          "secretName": "ssec",
        },
      },
      {
        "emptyDir": {},
        "name": "fb-agent",
      },
    ],
  },
}
`;

exports[`the aws client (the default) > is what it was before the object store builder: SSE-KMS 1`] = `
{
  "bootstrap from a logical backup": [
    {
      "args": [
        "set -eu; if [ -f "$DATABASE_PATH" ] || [ -f "$TARGET_PATH" ]; then echo "database exists, skipping bootstrap"; exit 0; fi; if [ -n "\${PRIMARY_FILE:-}" ]; then p=$(cat "$PRIMARY_FILE" 2>/dev/null || true); case "$p" in ""|"$POD_NAME"|"$POD_NAME".*) ;; *) echo "replica: seeded by replication, skipping bootstrap"; exit 0 ;; esac; fi; aws s3 cp 's3://bkt/p/nightly/x.fbk' /work/backup.fbk",
      ],
      "command": [
        "/bin/sh",
        "-c",
      ],
      "env": [
        {
          "name": "POD_NAME",
          "valueFrom": {
            "fieldRef": {
              "fieldPath": "metadata.name",
            },
          },
        },
        {
          "name": "DATABASE_PATH",
          "value": "/var/lib/firebird/data/mydb.fdb",
        },
        {
          "name": "TARGET_PATH",
          "value": "/var/lib/firebird/data/mydb.fdb",
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "valueFrom": {
            "secretKeyRef": {
              "key": "AWS_ACCESS_KEY_ID",
              "name": "s3-creds",
            },
          },
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "valueFrom": {
            "secretKeyRef": {
              "key": "AWS_SECRET_ACCESS_KEY",
              "name": "s3-creds",
            },
          },
        },
        {
          "name": "AWS_DEFAULT_REGION",
          "value": "us-east-1",
        },
      ],
      "image": "amazon/aws-cli:2.37.4",
      "name": "bootstrap-download",
      "volumeMounts": [
        {
          "mountPath": "/var/lib/firebird/data",
          "name": "firebird-data",
        },
        {
          "mountPath": "/work",
          "name": "work",
        },
      ],
    },
    {
      "args": [
        "set -eu; if [ -f "$DATABASE_PATH" ] || [ -f "$TARGET_PATH" ]; then echo "database exists, skipping bootstrap"; exit 0; fi; if [ -n "\${PRIMARY_FILE:-}" ]; then p=$(cat "$PRIMARY_FILE" 2>/dev/null || true); case "$p" in ""|"$POD_NAME"|"$POD_NAME".*) ;; *) echo "replica: seeded by replication, skipping bootstrap"; exit 0 ;; esac; fi; rm -f "$TARGET_PATH.tmp"; gbak -c '/work/backup.fbk' "$TARGET_PATH.tmp"; [ "$(id -u)" -ne 0 ] || chown firebird:firebird "$TARGET_PATH.tmp"; mv "$TARGET_PATH.tmp" "$TARGET_PATH"; echo "restored database from /work/backup.fbk"",
      ],
      "command": [
        "/bin/sh",
        "-c",
      ],
      "env": [
        {
          "name": "POD_NAME",
          "valueFrom": {
            "fieldRef": {
              "fieldPath": "metadata.name",
            },
          },
        },
        {
          "name": "DATABASE_PATH",
          "value": "/var/lib/firebird/data/mydb.fdb",
        },
        {
          "name": "TARGET_PATH",
          "value": "/var/lib/firebird/data/mydb.fdb",
        },
        {
          "name": "ISC_USER",
          "value": "SYSDBA",
        },
        {
          "name": "ISC_PASSWORD",
          "value": "masterkey",
        },
      ],
      "image": "firebirdsql/firebird:latest",
      "name": "bootstrap-restore",
      "volumeMounts": [
        {
          "mountPath": "/var/lib/firebird/data",
          "name": "firebird-data",
        },
        {
          "mountPath": "/work",
          "name": "work",
        },
      ],
    },
  ],
  "cluster backup schedule": {
    "containers": [
      {
        "args": [
          "set -eu; f=$(cat /work/.name); aws s3 cp --sse aws:kms --sse-kms-key-id 'alias/fb' "/work/$f" "s3://bkt/p/$f"",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "AWS_ACCESS_KEY_ID",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_ACCESS_KEY_ID",
                "name": "s3-creds",
