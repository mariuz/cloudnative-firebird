            "mountPath": "/work",
            "name": "work",
          },
        ],
      },
    ],
    "restartPolicy": "Never",
    "securityContext": {
      "runAsGroup": 84,
      "runAsNonRoot": true,
      "runAsUser": 84,
      "seccompProfile": {
        "type": "RuntimeDefault",
      },
