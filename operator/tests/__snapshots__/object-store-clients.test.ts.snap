      },
    ],
    "initContainers": [
      {
        "args": [
          "set -eu; f="backup-nightly-$(date -u +%Y%m%dT%H%M%SZ).fbk"; gbak -b "$FIREBIRD_HOST:$DATABASE_PATH" "/work/$f"; echo "$f" > /work/.name",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "ISC_USER",
            "value": "SYSDBA",
          },
          {
            "name": "ISC_PASSWORD",
            "value": "masterkey",
          },
          {
            "name": "FIREBIRD_HOST",
            "value": "db-0.db-headless",
          },
          {
            "name": "DATABASE_PATH",
            "value": "/var/lib/firebird/data/mydb.fdb",
          },
        ],
        "image": "firebirdsql/firebird:latest",
        "name": "firebird-backup",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
        ],
      },
    ],
    "restartPolicy": "Never",
    "securityContext": {
      "runAsGroup": 84,
      "runAsNonRoot": true,
      "runAsUser": 84,
      "seccompProfile": {
        "type": "RuntimeDefault",
      },
