  },
  "scheduled nbackup with retention": {
    "containers": [
      {
        "args": [
          "set -eu; f=$(cat /work/.name); if [ -f "/work/$f.ctl" ]; then aws s3 cp --sse aws:kms --sse-kms-key-id 'alias/fb' "/work/$f.ctl" "s3://bkt/p/$f.ctl"; fi; aws s3 cp --sse aws:kms --sse-kms-key-id 'alias/fb' "/work/$f" "s3://bkt/p/$f"; cutoff=$(date -u -d "@$(( $(date +%s) - 2419200 ))" +%Y%m%dT%H%M%SZ); { aws s3 ls 's3://bkt/p/' | awk '{ print $4 }'; } > /work/all || true; grep -E '^nbackup-l[0-2]-nightly-[0-9]{8}T[0-9]{6}Z[.]nbk$' /work/all | sort > /work/series || true; newest=$(tail -n 1 /work/series); awk -v c="$cutoff" -v n="$newest" -v f="$f" 'function series(x) { if (sub(/^nbackup-l[0-2]-/, "", x) && sub(/-[0-9]+T[0-9]+Z[.]nbk$/, "", x)) return x; return "" } FILENAME == ARGV[1] { h++; lvl[h] = $1; name[h] = $2; next } FILENAME == ARGV[2] { here[$0] = 1; s = series($0); if (s != "") live[s] = 1; next } $0 != n && $0 != f { ts = $0; sub(/^.*-/, "", ts); sub(/[.]nbk$/, "", ts); if (ts < c) old[$0] = 1 } END { for (i = 1; i <= h; i++) { l = lvl[i]; par[i] = (l > 0 && (l - 1) in last) ? last[l - 1] : 0; last[l] = i; known[name[i]] = 1 } for (i = 1; i <= h; i++) { if (name[i] in old) continue; s = series(name[i]); if (!(name[i] in here) && s != "" && (s in live)) continue; for (p = par[i]; p; p = par[p]) needed[name[p]] = 1 } for (k in old) if ((k in known) && !(k in needed)) print k }' /work/history /work/all /work/series > /work/expired; while read -r k; do aws s3 rm 's3://bkt/p/'"$k"; aws s3 rm 's3://bkt/p/'"$k.ctl" >/dev/null 2>&1 || true; echo "retention: deleted $k"; done < /work/expired; echo "retention: kept $(( $(wc -l < /work/series) - $(wc -l < /work/expired) )) backup(s) of nightly newer than $cutoff, newest or needed by a kept chain"",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "AWS_ACCESS_KEY_ID",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_ACCESS_KEY_ID",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_SECRET_ACCESS_KEY",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_SECRET_ACCESS_KEY",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_DEFAULT_REGION",
            "value": "us-east-1",
          },
          {
            "name": "FB_AGENT",
            "value": "/opt/fb-agent/fb-agent",
          },
        ],
        "image": "amazon/aws-cli:2.37.4",
        "name": "upload",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
          {
            "mountPath": "/opt/fb-agent",
            "name": "fb-agent",
            "readOnly": true,
          },
        ],
      },
    ],
    "initContainers": [
      {
        "command": [
          "cp",
          "/app/fb-agent",
          "/agent/fb-agent",
        ],
        "image": "ghcr.io/mariuz/cloudnative-firebird:latest",
        "name": "agent-install",
        "resources": {
          "requests": {
            "cpu": "10m",
            "memory": "16Mi",
          },
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
          "readOnlyRootFilesystem": true,
          "runAsGroup": 65532,
          "runAsNonRoot": true,
          "runAsUser": 65532,
        },
        "volumeMounts": [
          {
            "mountPath": "/agent",
            "name": "fb-agent",
          },
        ],
      },
      {
        "args": [
          "set -eu; f="nbackup-l0-nightly-$(date -u +%Y%m%dT%H%M%SZ).nbk"; trap '/opt/fb-agent/fb-agent backup-file remove "$f" || true' EXIT; fbsvcmgr "$FIREBIRD_HOST:service_mgr" action_nbak dbname "$DATABASE_PATH" nbk_file "/var/lib/firebird/data/$f" nbk_level 0; /opt/fb-agent/fb-agent backup-file get "$f" "/work/$f"; echo "$f" > /work/.name; echo 'set list on; select rdb$backup_level, rdb$file_name from rdb$backup_history order by rdb$backup_id;' | isql -q "$FIREBIRD_HOST:$DATABASE_PATH" | awk '/^RDB[$]BACKUP_LEVEL/ { l = $2 } /^RDB[$]FILE_NAME/ { n = $2; sub(/^.*[/]/, "", n); print l, n }' > /work/history",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "ISC_USER",
            "value": "SYSDBA",
          },
          {
            "name": "ISC_PASSWORD",
            "value": "masterkey",
          },
          {
            "name": "FIREBIRD_HOST",
            "value": "db-0.db-headless",
          },
          {
