          "aws s3 ls 's3://bkt/journals/' > /work/listing || true; awk '{ print $4 }' /work/listing > /work/uploaded; for f in $DATABASES; do d=/work/db/$f; mkdir -p $d; { aws s3 ls 's3://bkt/journals/'"$f/" > $d/listing || true; }; awk '{ print $4 }' $d/listing > $d/uploaded; done",
        ],
        "command": [
          "/bin/sh",
