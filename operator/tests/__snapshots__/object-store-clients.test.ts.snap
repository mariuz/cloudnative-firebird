  "point-in-time recovery": {
    "containers": [
      {
        "args": [
          "set -eu; . /etc/firebird-operator/pitr-restore.sh; out=$(fbsvcmgr "$FIREBIRD_HOST:service_mgr" action_nrest dbname "$TARGET_PATH" nbk_file "/var/lib/firebird/data/restore-$RESTORE_NAME-pitr.nbk" 2>&1) && rc=0 || rc=$?; [ -z "$out" ] || echo "$out"; if [ $rc -ne 0 ]; then if echo "$out" | grep -q 'File exists'; then echo "$TARGET_PATH already exists; left as is"; else fbsvcmgr "$FIREBIRD_HOST:service_mgr" action_nfix dbname "$TARGET_PATH" >/dev/null 2>&1 || true; if echo 'drop database;' | isql -q "$FIREBIRD_HOST:$TARGET_PATH" >/dev/null 2>&1; then echo "removed the partial restore $TARGET_PATH"; else echo "note: could not remove a partial restore at $TARGET_PATH"; fi; fi; exit $rc; fi; fbsvcmgr "$FIREBIRD_HOST:service_mgr" action_properties dbname "$TARGET_PATH" prp_replica_mode prp_rm_none || echo "note: could not clear the replica mode of $TARGET_PATH"; echo "restored into $TARGET_PATH"",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "ISC_USER",
            "value": "SYSDBA",
          },
          {
            "name": "ISC_PASSWORD",
            "value": "masterkey",
          },
          {
            "name": "FIREBIRD_HOST",
            "value": "db-0.db-headless",
          },
          {
            "name": "TARGET_PATH",
            "value": "/var/lib/firebird/data/restore-r1.fdb",
          },
          {
            "name": "SEGMENT_PORT",
            "value": "3051",
          },
          {
            "name": "RESTORE_NAME",
            "value": "r1",
          },
          {
            "name": "CHAIN_COUNT",
            "value": "2",
          },
          {
            "name": "SCRIPT_DIR",
            "value": "/etc/firebird-operator",
          },
          {
            "name": "TARGET_TIME",
            "value": "20261001T121530Z",
          },
          {
            "name": "FB_AGENT",
            "value": "/opt/fb-agent/fb-agent",
          },
        ],
        "image": "firebirdsql/firebird:latest",
        "name": "firebird-restore",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
          {
            "mountPath": "/etc/firebird-operator",
            "name": "cluster-config",
            "readOnly": true,
          },
          {
            "mountPath": "/opt/fb-agent",
            "name": "fb-agent",
            "readOnly": true,
          },
        ],
      },
      {
        "args": [
          "set -eu; W=/work; mkdir -p $W/segments $W/req; fail() { echo "$1" > /work/fetcher.failed; echo "$1" >&2; exit 1; }; aws s3 ls 's3://bkt/journals/' > $W/journals.tmp 2> $W/ls.err || [ ! -s $W/ls.err ] || fail "listing the journal archive failed: $(cat $W/ls.err)"; mv $W/journals.tmp $W/journals.list; start=$(date +%s); while [ ! -f $W/finished ]; do for r in $W/req/*.req; do [ -f "$r" ] || continue; err=""; for s in $(cat "$r"); do case "$s" in *[!A-Za-z0-9._-]*) err="invalid segment name $s"; break ;; esac; aws s3 cp --only-show-errors 's3://bkt/journals/'"$s" "$W/segments/$s" 2> $W/cp.err || { err="$s: $(cat $W/cp.err)"; break; }; done; if [ -z "$err" ]; then mv "$r" "\${r%.req}.ok"; else echo "$err" > "\${r%.req}.err"; rm -f "$r"; fi; done; hb=$(cat $W/heartbeat 2>/dev/null || true); [ $(( $(date +%s) - \${hb:-$start} )) -lt 300 ] || fail "the Firebird container stopped"; sleep 1; done",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "AWS_DEFAULT_REGION",
            "value": "eu-west-1",
          },
          {
            "name": "FB_AGENT",
            "value": "/opt/fb-agent/fb-agent",
          },
        ],
        "image": "amazon/aws-cli:2.37.4",
        "name": "journal-fetch",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
          {
            "mountPath": "/opt/fb-agent",
            "name": "fb-agent",
            "readOnly": true,
          },
        ],
      },
