          },
        ],
      },
    ],
    "initContainers": [
      {
        "command": [
          "cp",
          "/app/fb-agent",
          "/agent/fb-agent",
        ],
        "image": "ghcr.io/mariuz/cloudnative-firebird:latest",
        "name": "agent-install",
        "resources": {
          "requests": {
            "cpu": "10m",
            "memory": "16Mi",
