  "nbackup of a replica": {
    "containers": [
      {
        "args": [
          "set -eu; f=$(cat /work/.name); if [ -f "/work/$f.ctl" ]; then aws s3 cp --sse aws:kms --sse-kms-key-id 'alias/fb' "/work/$f.ctl" "s3://bkt/p/$f.ctl"; fi; aws s3 cp --sse aws:kms --sse-kms-key-id 'alias/fb' "/work/$f" "s3://bkt/p/$f"",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "AWS_ACCESS_KEY_ID",
