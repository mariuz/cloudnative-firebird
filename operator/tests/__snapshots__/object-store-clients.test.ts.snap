        "args": [
          "set -eu; W=/work; mkdir -p $W/segments $W/req; fail() { echo "$1" > /work/fetcher.failed; echo "$1" >&2; exit 1; }; aws s3 ls 's3://bkt/p/journals/sales.fdb/' > $W/journals.tmp 2> $W/ls.err || [ ! -s $W/ls.err ] || fail "listing the journal archive failed: $(cat $W/ls.err)"; mv $W/journals.tmp $W/journals.list; start=$(date +%s); while [ ! -f $W/finished ]; do for r in $W/req/*.req; do [ -f "$r" ] || continue; err=""; for s in $(cat "$r"); do case "$s" in *[!A-Za-z0-9._-]*) err="invalid segment name $s"; break ;; esac; aws s3 cp --only-show-errors 's3://bkt/p/journals/sales.fdb/'"$s" "$W/segments/$s" 2> $W/cp.err || { err="$s: $(cat $W/cp.err)"; break; }; done; if [ -z "$err" ]; then mv "$r" "\${r%.req}.ok"; else echo "$err" > "\${r%.req}.err"; rm -f "$r"; fi; done; hb=$(cat $W/heartbeat 2>/dev/null || true); [ $(( $(date +%s) - \${hb:-$start} )) -lt 300 ] || fail "the Firebird container stopped"; sleep 1; done",
