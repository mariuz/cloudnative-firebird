        "args": [
          "set -eu; aws s3 sync /work/segments/ 's3://bkt/journals/'; for f in $DATABASES; do d=/work/db/$f; mkdir -p $d; [ ! -d $d/segments ] || aws s3 sync $d/segments/ 's3://bkt/journals/'"$f/"; done",
