        "name": "work",
      },
    ],
  },
  "journal archive": {
    "containers": [
      {
        "args": [
          "set -eu; aws s3 sync --sse aws:kms --sse-kms-key-id 'alias/fb' /work/segments/ 's3://bkt/p/journals/'; for f in $DATABASES; do d=/work/db/$f; mkdir -p $d; [ ! -d $d/segments ] || aws s3 sync --sse aws:kms --sse-kms-key-id 'alias/fb' $d/segments/ 's3://bkt/p/journals/'"$f/"; done",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "AWS_ACCESS_KEY_ID",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_ACCESS_KEY_ID",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_SECRET_ACCESS_KEY",
            "valueFrom": {
              "secretKeyRef": {
                "key": "AWS_SECRET_ACCESS_KEY",
                "name": "s3-creds",
              },
            },
          },
          {
            "name": "AWS_DEFAULT_REGION",
            "value": "us-east-1",
          },
          {
            "name": "DATABASES",
            "value": "sales.fdb",
          },
          {
            "name": "FB_AGENT",
            "value": "/opt/fb-agent/fb-agent",
          },
        ],
        "image": "amazon/aws-cli:2.37.4",
        "name": "upload",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
          {
            "mountPath": "/opt/fb-agent",
            "name": "fb-agent",
            "readOnly": true,
          },
        ],
      },
    ],
    "initContainers": [
      {
        "command": [
          "cp",
          "/app/fb-agent",
          "/agent/fb-agent",
        ],
        "image": "ghcr.io/mariuz/cloudnative-firebird:latest",
        "name": "agent-install",
        "resources": {
          "requests": {
            "cpu": "10m",
            "memory": "16Mi",
          },
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
          "readOnlyRootFilesystem": true,
          "runAsGroup": 65532,
          "runAsNonRoot": true,
          "runAsUser": 65532,
        },
        "volumeMounts": [
          {
            "mountPath": "/agent",
            "name": "fb-agent",
          },
        ],
      },
      {
        "args": [
          "aws s3 ls 's3://bkt/p/journals/' > /work/listing || true; awk '{ print $4 }' /work/listing > /work/uploaded; for f in $DATABASES; do d=/work/db/$f; mkdir -p $d; { aws s3 ls 's3://bkt/p/journals/'"$f/" > $d/listing || true; }; awk '{ print $4 }' $d/listing > $d/uploaded; done",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
