            "value": "/var/lib/firebird/data/mydb.fdb",
          },
          {
            "name": "SEGMENT_PORT",
            "value": "3051",
          },
          {
            "name": "FB_AGENT",
            "value": "/opt/fb-agent/fb-agent",
          },
        ],
        "image": "firebirdsql/firebird:latest",
        "name": "firebird-backup",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
          {
            "mountPath": "/etc/firebird-operator",
            "name": "cluster-config",
            "readOnly": true,
          },
          {
            "mountPath": "/opt/fb-agent",
            "name": "fb-agent",
            "readOnly": true,
          },
        ],
      },
    ],
    "restartPolicy": "Never",
    "securityContext": {
      "runAsGroup": 84,
      "runAsNonRoot": true,
      "runAsUser": 84,
      "seccompProfile": {
        "type": "RuntimeDefault",
      },
    },
    "volumes": [
