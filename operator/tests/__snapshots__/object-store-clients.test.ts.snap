          },
          {
            "name": "FB_AGENT",
            "value": "/opt/fb-agent/fb-agent",
          },
        ],
        "image": "firebirdsql/firebird:latest",
        "name": "fetch-segments",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work",
          },
          {
            "mountPath": "/etc/firebird-operator",
            "name": "cluster-config",
            "readOnly": true,
          },
          {
            "mountPath": "/opt/fb-agent",
            "name": "fb-agent",
            "readOnly": true,
          },
        ],
      },
      {
        "args": [
          "set -eu; for f in $DATABASES; do d=/work/db/$f; mkdir -p $d; SEGMENT_DATABASE=$f OUT_DIR=$d/segments SKIP_FILE=$d/uploaded LISTED_FILE=$d/listed-max RESULT_FILE=$d/result /opt/fb-agent/fb-agent fetch-segments; done",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "ISC_USER",
            "value": "SYSDBA",
          },
          {
            "name": "ISC_PASSWORD",
            "value": "masterkey",
          },
          {
            "name": "FIREBIRD_HOST",
            "value": "db-0.db-headless",
          },
          {
            "name": "SEGMENT_PORT",
            "value": "3051",
          },
          {
            "name": "DATABASES",
            "value": "sales.fdb",
          },
          {
            "name": "FB_AGENT",
            "value": "/opt/fb-agent/fb-agent",
          },
        ],
        "image": "firebirdsql/firebird:latest",
        "name": "fetch-database-segments",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL",
            ],
          },
        },
        "volumeMounts": [
          {
            "mountPath": "/work",
