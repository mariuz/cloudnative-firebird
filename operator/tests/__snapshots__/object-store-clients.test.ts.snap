          },
          {
            "mountPath": "/etc/firebird-operator",
            "name": "cluster-config",
            "readOnly": true,
          },
          {
            "mountPath": "/opt/fb-agent",
            "name": "fb-agent",
            "readOnly": true,
          },
        ],
      },
    ],
    "restartPolicy": "Never",
    "securityContext": {
      "runAsGroup": 84,
      "runAsNonRoot": true,
      "runAsUser": 84,
      "seccompProfile": {
        "type": "RuntimeDefault",
      },
    },
    "volumes": [
