    ],
    "image": "amazon/aws-cli:2.37.4",
    "name": "archive-follower",
    "resources": {
      "requests": {
        "cpu": "10m",
        "memory": "64Mi",
      },
    },
    "volumeMounts": [
      {
        "mountPath": "/var/lib/firebird/data",
        "name": "firebird-data",
