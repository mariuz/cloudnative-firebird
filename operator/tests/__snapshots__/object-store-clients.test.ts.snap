    "initContainers": [
      {
        "args": [
          "set -eu; f="backup-db-$(date -u +%Y%m%dT%H%M%SZ).fbk"; gbak -b "$FIREBIRD_HOST:$DATABASE_PATH" "/work/$f"; echo "$f" > /work/.name",
        ],
        "command": [
          "/bin/sh",
