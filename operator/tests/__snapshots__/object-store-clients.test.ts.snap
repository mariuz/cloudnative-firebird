  "nbackup of a replica": {
    "containers": [
      {
        "args": [
          "set -eu; f=$(cat /work/.name); if [ -f "/work/$f.ctl" ]; then aws s3 cp "/work/$f.ctl" "s3://bkt/$f.ctl"; fi; aws s3 cp "/work/$f" "s3://bkt/$f"",
        ],
        "command": [
          "/bin/sh",
          "-c",
        ],
        "env": [
          {
            "name": "AWS_DEFAULT_REGION",
